# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin User IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=

# Allowed Users (comma-separated; leave empty to allow everyone)
ALLOWED_USERS=

# Optional Proxy (HTTP or SOCKS5)
# PROXY_URL=http://127.0.0.1:8080
# PROXY_URL=socks5://127.0.0.1:9050
PROXY_URL=

# Rate Limiting & Concurrency
RATE_LIMIT_SECONDS=3.0
MAX_CONCURRENT_LINKS=5

# Network Timeouts
REQUEST_TIMEOUT=20
MAX_RETRIES=2
MAX_REDIRECTS=15

# Cache & Storage
CACHE_ENABLED=true
CACHE_TTL_DAYS=14
DATABASE_FILE=bypasser.db

# Headless Browser (Playwright) Fallback
ENABLE_PLAYWRIGHT=true
PLAYWRIGHT_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=INFO
